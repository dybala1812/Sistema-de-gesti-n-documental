# =============================================================================
# SGD · Frontend — plantilla de variables de entorno (SIN secretos)
# Copiar a .env.local y ajustar. .env.local nunca se sube a git.
#
# Todo lo que empiece por NEXT_PUBLIC_ es visible en el navegador: nunca poner
# aquí contraseñas ni claves secretas. Esas van en backend_gestion_documental/.env
# =============================================================================

NEXT_PUBLIC_APP_NAME="Sistema de Gestión Documental"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_UNIVERSIDAD="Universidad Autónoma del Cauca"

# Clave pública del CAPTCHA del portal (D-11 por decidir). Vacío = deshabilitado.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

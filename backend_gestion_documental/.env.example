# =============================================================================
# SGD · Backend — plantilla de variables de entorno (SIN secretos reales)
# Copiar a .env y completar. .env nunca se sube a git.
# Guía completa: base-de-datos/README.md
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (Supabase). Ver base-de-datos/README.md pasos 1-4.
# sgd_api: rol general de la API. sgd_auth: solo login/credenciales/sesiones.
# -----------------------------------------------------------------------------
DATABASE_URL_API="postgresql://sgd_api.<id-proyecto>:<contraseña-sgd_api>@<host-pooler>:6543/postgres?sslmode=require&pgbouncer=true"
DATABASE_URL_AUTH="postgresql://sgd_auth.<id-proyecto>:<contraseña-sgd_auth>@<host-pooler>:6543/postgres?sslmode=require&pgbouncer=true"
# Conexión directa (puerto 5432) como dueño del esquema, para prisma db pull
# y los scripts de base-de-datos/pruebas/. Nunca la usa la API en ejecución.
DIRECT_URL="postgresql://postgres:<contraseña-owner>@db.<id-proyecto>.supabase.co:5432/postgres?sslmode=require"

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
TZ=America/Bogota
CORS_ORIGIN="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"
API_BASE_URL="http://localhost:4000/api/v1"

# -----------------------------------------------------------------------------
# Autenticación (RF-013). Generar cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Un valor distinto por integrante/entorno; nunca reutilizar el de otro .env.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="<generar-uno-propio>"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="<generar-uno-propio-distinto>"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="<generar-uno-propio>"
COOKIE_NAME="sgd_sesion"
COOKIE_SECURE=false
BCRYPT_SALT_ROUNDS=12
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# -----------------------------------------------------------------------------
# Adjuntos (D-09 por decidir). "local" para desarrollo; "supabase" cuando el
# equipo decida usar Supabase Storage.
# -----------------------------------------------------------------------------
STORAGE_DRIVER="local"
UPLOADS_DIR="./uploads"
MAX_UPLOAD_MB=100
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="adjuntos-sgd"

# -----------------------------------------------------------------------------
# Correo (D-10 por decidir: SMTP institucional vs. API)
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Sistema de Gestión Documental <no-responder@uniautonoma.edu.co>"
CORREO_RECEPCION=""
CORREO_REGISTRO_ACADEMICO=""

# -----------------------------------------------------------------------------
# CAPTCHA del portal público (D-11 por decidir). Propuesta: Cloudflare Turnstile.
# -----------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=""
PORTAL_RATE_LIMIT_MAX=20
PORTAL_RATE_LIMIT_WINDOW_MINUTOS=15

# -----------------------------------------------------------------------------
# n8n (pendiente confirmar adopción, ver I-01)
# -----------------------------------------------------------------------------
N8N_SERVICE_TOKEN=""
N8N_WEBHOOK_URL=""
